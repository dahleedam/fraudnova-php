{
    "name": "fraudnova/fraudnova-php",
    "description": "Official PHP client for the FraudNova fraud-detection API: fraud scores and risk flags for IP addresses, email addresses and phone numbers.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://fraudnova.com",
    "keywords": ["fraudnova", "fraud-detection", "fraud-score", "proxy-detection", "vpn-detection", "email-validation", "phone-validation", "api-client", "laravel"],
    "authors": [
        {"name": "FraudNova", "email": "support@fraudnova.com"}
    ],
    "support": {
        "docs": "https://fraudnova.com/docs",
        "email": "support@fraudnova.com",
        "issues": "https://github.com/dahleedam/fraudnova-php/issues",
        "source": "https://github.com/dahleedam/fraudnova-php"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.20",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Picked up automatically as the HTTP client when installed",
        "illuminate/support": "Enables the Laravel service provider and facade"
    },
    "autoload": {
        "psr-4": {"FraudNova\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"FraudNova\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["FraudNova\\Laravel\\FraudNovaServiceProvider"],
            "aliases": {"FraudNova": "FraudNova\\Laravel\\Facades\\FraudNova"}
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
